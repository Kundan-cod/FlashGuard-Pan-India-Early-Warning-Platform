# =============================================================================
# SIH 2026 PS 26192 — Flash Flood Prediction System
# Environment variable template.  Copy to `.env` and fill real values locally.
#   cp .env.example .env
# NEVER commit the real .env. NEVER hard-code secrets in source (prompt s.36/55).
#
# Every value with EXTERNAL_VERIFICATION_REQUIRED is a placeholder: the real
# auth mechanism for that source is confirmed by ChatGPT (prompt s.60-63)
# before it is used. The portable demo core needs NONE of these to run.
# =============================================================================

# ---- Runtime mode -----------------------------------------------------------
# live | near_real_time | replay | simulation   (prompt s.41, s.64)
APP_MODE=replay
APP_ENV=development
LOG_LEVEL=INFO

# ---- Portable core (Track A — runs with zero external services) -------------
PORTABLE_DB_PATH=./data/portable/flashflood.sqlite
PORTABLE_API_HOST=127.0.0.1
PORTABLE_API_PORT=8000

# ---- Production DB (Track B — PostgreSQL + PostGIS) -------------------------
DATABASE_URL=postgresql+psycopg2://ffuser:ffpass@localhost:5432/flashflood
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=flashflood
POSTGIS_USER=ffuser
POSTGIS_PASSWORD=CHANGE_ME_LOCALLY

# ---- Cache / scheduler (Track B) -------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- External data-source credentials (fill only after ChatGPT verifies) ----
# Leave blank until verified; collectors stay disabled while blank.
NASA_EARTHDATA_TOKEN=
IMD_API_KEY=
MOSDAC_API_KEY=
BHUVAN_API_KEY=
GSI_API_KEY=
CWC_API_KEY=
NDEM_API_KEY=

# ---- IoT (our own component) ------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=sih26192/sensors
IOT_DEVICE_SHARED_SECRET=CHANGE_ME_LOCALLY

# ---- API security (Track B) -------------------------------------------------
API_JWT_SECRET=CHANGE_ME_LOCALLY
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
