# =============================================================================
# SIH 2026 PS 26192 — Flash Flood Prediction System
# Environment variable template.  Copy to `.env` and fill real values locally.
#   cp .env.example .env
# NEVER commit the real .env. NEVER hard-code secrets in source (prompt s.36/55).
#
# Every value with EXTERNAL_VERIFICATION_REQUIRED is a placeholder: the real
# auth mechanism for that source is confirmed by ChatGPT (prompt s.60-63)
# before it is used. The portable demo core needs NONE of these to run.
# =============================================================================

# ---- Runtime mode -----------------------------------------------------------
# live | near_real_time | replay | simulation   (prompt s.41, s.64)
APP_MODE=replay
APP_ENV=development
LOG_LEVEL=INFO

# ---- Portable core (Track A — runs with zero external services) -------------
PORTABLE_DB_PATH=./data/portable/flashflood.sqlite
PORTABLE_API_HOST=127.0.0.1
PORTABLE_API_PORT=8000

# ---- Production DB (Track B — PostgreSQL + PostGIS) -------------------------
# These POSTGRES_* names are what docker-compose.yml reads to provision the
# `db` container AND to build the backend's DATABASE_URL (host `db`, the compose
# service name). Keep the names exactly as-is or compose falls back to defaults.
POSTGRES_USER=flashguard
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_DB=flashguard
# Used only if you run the backend OUTSIDE compose (host `localhost`). Inside
# compose this is overridden to point at the `db` service automatically.
DATABASE_URL=postgresql+psycopg2://flashguard:CHANGE_ME_LOCALLY@localhost:5432/flashguard
# Seed the replay demo on boot (1) or start empty for live collectors (0).
SEED_REPLAY=1

# ---- Cache / scheduler (Track B) -------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- External data-source credentials (fill only after ChatGPT verifies) ----
# Leave blank until verified; collectors stay disabled while blank.
# GPM (PMM Publisher discovery + product downloads) reads NASA_EARTHDATA_TOKEN.
# With a token, the DEFAULT image runs discovery-only (real dataset metadata +
# download URLs -> gpm_discovery, numeric_value NULL). To get REAL numeric mm in
# rainfall_observations you must ALSO run the rasterio-enabled ML image:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.ml.yml \
#       up -d --build backend
# Even then a value appears only if the discovered PMM product is a scientific
# GeoTIFF/NetCDF (browse PNGs are refused). GPM_ENABLE_RASTER=1 (default) permits
# the gated stage; set 0 to force discovery-only.
NASA_EARTHDATA_TOKEN=
# SMAP (NASA CMR granule discovery + protected HDF5 downloads) reads
# EARTHDATA_TOKEN — this is the SAME NASA Earthdata Login token; the vendored,
# verified SMAP package (sih_smap/config.py) reads this exact variable name, so
# the data_sources.yml smap.auth_env_var was set to EARTHDATA_TOKEN to match. You
# can set both to the same token value. Blank -> SMAP stays NOT_CONFIGURED.
EARTHDATA_TOKEN=
# IMD (India Meteorological Department) reads IMD_API_TOKEN — the vendored,
# verified IMD package (sih_imd/config.py) reads this exact variable name, so
# data_sources.yml imd.auth_env_var was set to IMD_API_TOKEN to match. IMD
# registration requires an official organizational email; the collector never
# invents a credential header. Blank -> IMD stays NOT_CONFIGURED (app stays on
# replay). Optional overrides: IMD_API_BASE_URL, IMD_TIMEOUT_SECONDS,
# IMD_MAX_RETRIES (see sih_imd/config.py defaults).
IMD_API_TOKEN=
# ISRO MOSDAC — the CONFIGURATION gate is MOSDAC_API_BASE_URL, NOT a key. The
# verified MOSDAC package (sih_mosdac/config.py) hard-codes NO public endpoint by
# design (the verified note: "Do not invent a public REST endpoint"), so the
# operator supplies the mdapi/config service URL here. Blank -> MOSDAC stays
# NOT_CONFIGURED (app stays on replay/discovery-only). Granule SEARCH is
# anonymous; MOSDAC_USERNAME/MOSDAC_PASSWORD are needed ONLY for the
# (unimplemented) download stage — never for discovery. Optional overrides:
# MOSDAC_TIMEOUT_SECONDS, MOSDAC_MAX_RETRIES, MOSDAC_DOWNLOAD_PATH.
MOSDAC_API_BASE_URL=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
# Bhuvan / NRSC — CATALOG-ONLY, needs NO credentials. The verified registry
# hard-codes the real public OGC endpoints, so verified:true alone builds the
# layer catalog (source reports LIVE). These optional overrides let an operator
# point at a mirror/proxy of the public WMS/WMTS services; blank -> the vendored
# verified defaults (bhuvan-vec2.nrsc.gov.in) are used. There is deliberately no
# BHUVAN token: cataloging reads no pixels and needs no login. A future CartoDEM
# tile-DOWNLOAD stage (not implemented) may need a Bhuvan login — out of scope.
BHUVAN_WMS_URL=
BHUVAN_WMTS_URL=
# GSI / Bhusanket — CATALOG-ONLY, needs NO credentials. The verified registry
# hard-codes the real public portal (https://bhusanket.gsi.gov.in), so
# verified:true alone builds the layer catalog (source reports LIVE). The verified
# adapter "does not hard-code an undocumented JSON API"; there is deliberately no
# GSI token. These optional overrides let an operator point at a mirror/proxy of
# the public portal; blank -> the vendored verified default is used. A future
# gated parse of a specific documented public resource is out of scope here.
GSI_BHUSANKET_BASE_URL=
GSI_TIMEOUT_SECONDS=
GSI_MAX_RETRIES=
# CWC / NWIC — CATALOG-ONLY, needs NO credentials. The verified config hard-codes
# the real public National Water Data Portal (https://www.nwdp.nwic.gov.in), so
# verified:true alone builds the dataset catalog (source reports LIVE). The
# verified adapter "does not invent an undocumented API URL"; the portal advertises
# API as a format but the exact endpoint/auth contract was NOT verified, so there
# is deliberately no CWC token. These optional overrides let an operator point at a
# mirror/proxy of the public portal; blank -> the vendored verified default is
# used. A future authenticated/live CSV/API parse is out of scope here.
NWDP_BASE_URL=
NWDP_TIMEOUT_SECONDS=
NWDP_MAX_RETRIES=
# LGD (Local Government Directory) — CATALOG-ONLY, needs NO credentials. The
# verified config hard-codes the real public download portal
# (https://lgdirectory.gov.in/demo/downloadDirectory.do), so verified:true alone
# builds the directory catalog (source reports LIVE). The verified adapter fetches
# only the download page and "does not guess file names or fabricate geometry
# URLs"; there is deliberately no LGD token. LGD is authoritative for
# administrative identity/CODES, NOT boundary geometry — geometry must come from an
# authoritative GIS product and be joined by LGD code. These optional overrides let
# an operator point at a mirror/proxy of the public portal; blank -> the vendored
# verified default is used. A future gated parse of a downloaded directory file is
# out of scope here.
LGD_DOWNLOAD_BASE_URL=
LGD_TIMEOUT_SECONDS=
LGD_MAX_RETRIES=
# NDEM (National Database for Emergency Management, NRSC/ISRO + MHA) —
# CATALOG-ONLY, needs NO credentials. The verified config hard-codes the real
# public portal (https://ndem.nrsc.gov.in), so verified:true alone builds the
# capability catalog (source reports LIVE). The verified note is explicit: NDEM's
# non-base products are PROTECTED (login for Central/State/District/NDRF/SDRF
# officials only), so the connector "never bypasses authentication or invents an
# undocumented API" and stores each capability's access level (PUBLIC /
# AUTHORIZED / AUTHORIZED_OR_PRODUCT_SPECIFIC) as metadata, SEPARATELY from any
# risk score. Cataloging the PUBLIC capability list reads no protected product
# and needs no login. These optional overrides let an operator point at a
# mirror/proxy of the public portal; blank -> the vendored verified default is
# used. NDEM_USERNAME/NDEM_PASSWORD are for a FUTURE gated AUTHORIZED adapter
# ONLY (never used by the catalog stage) — leave blank.
NDEM_BASE_URL=
NDEM_TIMEOUT_SECONDS=
NDEM_MAX_RETRIES=
NDEM_USERNAME=
NDEM_PASSWORD=

# ---- IoT (our own component) ------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=sih26192/sensors
IOT_DEVICE_SHARED_SECRET=CHANGE_ME_LOCALLY

# ---- API security (Track B) -------------------------------------------------
API_JWT_SECRET=CHANGE_ME_LOCALLY
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
